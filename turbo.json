{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "API_URL", "NEXT_PUBLIC_APP_ENV"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "out/**", "dist/**"] },
    "lint": {},
    "typecheck": {},
    "test": { "outputs": [] },
    "dev": { "cache": false, "persistent": true }
  }
}
